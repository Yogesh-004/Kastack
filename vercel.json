{
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api",
      "transforms": [
        { "type": "request.path", "op": "set", "args": "/$1" }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{outputs/**,web/**,data/README.md}",
      "maxDuration": 10
    }
  }
}