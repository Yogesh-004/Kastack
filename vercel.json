{
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "web.app:app",
      "functions": {
        "web/app.py": {
          "includeFiles": "{outputs/**,web/**,src/**,data/README.md}",
          "maxDuration": 10
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}